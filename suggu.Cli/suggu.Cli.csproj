<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Global dotnet tool packaging: dotnet tool install -g suggu -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>suggu</ToolCommandName>
    <PackageId>suggu</PackageId>
    <Version>0.2.2</Version>
    <Authors>Shubham</Authors>
    <Description>Deterministic scaffolding and verification CLI for .NET clean-architecture projects. suggu owns the deterministic 90%; the AI fills the semantic 10%.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\suggu.Core\suggu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Infrastructure\" />
  </ItemGroup>

</Project>
