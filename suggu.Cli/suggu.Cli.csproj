<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Global dotnet tool packaging: dotnet tool install -g suggu -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>suggu</ToolCommandName>
    <PackageId>suggu</PackageId>
    <Version>0.5.2</Version>
    <Authors>Shubham</Authors>
    <Description>Global file-system and .NET productivity CLI for scaffolding, inspection, build diagnostics, and endpoint flow tracing.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\suggu.Core\suggu.Core.csproj" />
  </ItemGroup>

</Project>
